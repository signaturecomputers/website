rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ADMIN USERS - Read for login, write for own document
    match /admin_users/{userId} {
      allow read: if true;   // Needed for login
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ADMIN SETTINGS - Read only for access key verification
    match /admin_settings/{docId} {
      allow read: if true;   // Needed for access key check
      allow write: if false;
    }

    // PRODUCTS (Laptops, Desktops, etc.)
    // Public Read, Admin Write via Web SDK
    match /laptops/{document=**} {
      allow read: if true;
      allow write: if true; // Required for Web SDK product management
    }
    match /desktops/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /monitors/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /accessories/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /printers/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /cartridges/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /toners/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // USERS (Regular Customers)
    // Authenticated users can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      // Prevent deleting other users
      allow delete: if false; 
    }
    
    // ORDERS
    // Users can read/create orders where they are the owner
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update: if false; // Only admin updates status (via Server Action ideally)
      allow delete: if false;
    }

    // CARTS (Optional, if stored in Firestore)
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
