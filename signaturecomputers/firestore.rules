rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == "admin";
    }

    // ============================================
    // ADMIN COLLECTIONS
    // ============================================

    // ADMIN USERS - Read for login, writes only via server-side Admin SDK
    match /admin_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ADMIN SETTINGS - Admin only read/write
    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // SITE SETTINGS - Festival Themes, etc. (Public read, admin write)
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // PRODUCT CATEGORIES (Main Categories)
    // ============================================

    match /laptops/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /desktops/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /workstations/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /monitors/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /printers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /memory/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storage/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /graphics-cards/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /accessories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cctv/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cartridges/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /toners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // ACCESSORY SUBCATEGORIES
    // ============================================

    match /keyboards/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /mouse/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /keyboard-mouse-combo/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /headphones/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cables/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /power-adapters/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /bags/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /docks/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hubs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /usb-flashdrives/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /dvd-writers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // CATEGORY MANAGEMENT
    // ============================================

    match /category_metadata/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // USER MANAGEMENT
    // ============================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // ============================================
    // ORDERS
    // ============================================

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationRequested', 'cancellationRequestedAt', 'cancellationRequestId', 'cancellationReason', 'returnRequested', 'returnRequestedAt', 'returnRequestId', 'returnReason']));
      allow delete: if false;
    }

    // ============================================
    // CART
    // ============================================

    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // MARKETING & CONTENT
    // ============================================

    match /hot_deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /care_packs/{packId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /header_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /display_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // INVOICES & BILLING
    // ============================================

    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // REFUNDS & RETURNS
    // ============================================

    match /refunds/{refundId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cancellation_requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /return_requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ============================================
    // FEEDBACK
    // ============================================

    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // RATE LIMITING ATTEMPTS (Server-only, client-deny)
    // ============================================

    match /admin_login_attempts/{docId} {
      allow read, write: if false;
    }

    match /customer_login_attempts/{docId} {
      allow read, write: if false;
    }

    // ============================================
    // DEFAULT DENY (Must be last)
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
