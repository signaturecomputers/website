rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ADMIN USERS - Read for login, write for own document
    match /admin_users/{userId} {
      allow read: if true;   // Needed for login
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ADMIN SETTINGS - Read only for access key verification
    match /admin_settings/{docId} {
      allow read: if true;   // Needed for access key check
      allow write: if false;
    }

    // PRODUCTS - All categories (Public Read, Authenticated Write)
    match /laptops/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /desktops/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /monitors/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /accessories/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /printers/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /cartridges/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /toners/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    // Additional accessory subcategories
    match /keyboards/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /headphones/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /cables/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /power-adapters/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /mouse/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /keyboard-mouse-combo/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /bags/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /docks/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /usb-flashdrives/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /dvd-writers/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /workstations/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /cctv/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // USERS - Public read for admin dashboard
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; 
    }
    
    // ORDERS - Public read for admin dashboard
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if true;
      allow delete: if false;
    }

    // CARTS
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // HOT DEALS - Public read, authenticated write
    match /hot_deals/{dealId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
