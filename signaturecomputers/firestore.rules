rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ============================================
    // ADMIN COLLECTIONS
    // ============================================

    // ADMIN USERS - Read for login, write for own document
    match /admin_users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ADMIN SETTINGS - Read only for access key verification
    match /admin_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================
    // PRODUCT CATEGORIES (Main Categories)
    // ============================================

    match /laptops/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /desktops/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /workstations/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /monitors/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /printers/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /accessories/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /cctv/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================
    // PRINTER SUBCATEGORIES
    // ============================================

    match /cartridges/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /toners/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================
    // ACCESSORY SUBCATEGORIES
    // ============================================

    match /keyboards/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /mouse/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /keyboard-mouse-combo/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /headphones/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /cables/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /power-adapters/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /bags/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /docks/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /usb-flashdrives/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /dvd-writers/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================
    // CATEGORY MANAGEMENT (NEW)
    // ============================================

    // Category Metadata - Stores custom images and descriptions for categories
    match /category_metadata/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom Categories - Admin-created categories and subcategories
    match /custom_categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection (legacy/alternative)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================
    // USER MANAGEMENT
    // ============================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // ============================================
    // ORDERS
    // ============================================

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if true;
      allow delete: if false;
    }

    // ============================================
    // CART
    // ============================================

    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // MARKETING & CONTENT
    // ============================================

    // Hot Deals
    match /hot_deals/{dealId} {
      allow read: if true;
      allow write: if true;
    }

    // Header Settings - Hero images and brand logos
    match /header_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Display Reviews - Testimonials shown on homepage
    match /display_reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================
    // FEEDBACK
    // ============================================

    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if true;
    }

    // ============================================
    // DEFAULT DENY (Must be last)
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
