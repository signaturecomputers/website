rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // PRODUCTS (Laptops, Desktops, etc.)
    // Public Read, No Client Write (Admin writes via Server Actions)
    match /laptops/{document=**} {
      allow read: if true;
      allow write: if false; 
    }
    match /desktops/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /monitors/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /accessories/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /printers/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /cartridges/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /toners/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // USERS (Regular Customers)
    // Authenticated users can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      // Prevent deleting other users
      allow delete: if false; 
    }
    
    // ORDERS
    // Users can read/create orders where they are the owner
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update: if false; // Only admin updates status (via Server Action ideally)
      allow delete: if false;
    }

    // CARTS (Optional, if stored in Firestore)
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
