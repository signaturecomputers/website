rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin via Firestore
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role == "admin";
    }

    // Product images - Public read, admin write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Category images - Public read, admin write
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Brand logos - Public read, admin write  
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hero/banner images - Public read, admin write
    match /hero/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User uploads (profile pictures, etc.)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;  // Public profile pictures
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Temp uploads - for processing
    match /temp/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
